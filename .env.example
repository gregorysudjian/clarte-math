# Copy to .env.local and fill in. Never commit real values.

# Password for the owner dashboard at /hq
HQ_PASSWORD=

# Where the dashboard stores its data file (default: ./data)
HQ_DATA_DIR=

# Public site details
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_PHONE=

# Email (optional). Gmail is used when set, otherwise Resend.
# Gmail needs an app password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
# Inbox that receives new tutoring requests
BOOKING_TO_EMAIL=
